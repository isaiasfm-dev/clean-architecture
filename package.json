{
  "name": "clean-architecture",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/main.js",
  "imports": {
    "#application/*": "./dist/src/application/*.js",
    "#composition/*": "./dist/src/composition/*.js",
    "#domain/*": "./dist/src/domain/*.js",
    "#infrastructure/*": "./dist/src/infrastructure/*.js",
    "#shared/*": "./dist/src/shared/*.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "check:tests": "tsc --noEmit --project tsconfig.test.json",
    "validate": "npm run check && npm run check:tests && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx main.ts",
    "db:up": "docker compose --env-file .env.db up -d postgres",
    "db:down": "docker compose --env-file .env.db down",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "worker:outbox": "tsx src/composition/OutboxWorkerCli.ts",
    "start": "node dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.5.4"
  }
}
