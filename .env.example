# Entorno
NODE_ENV=development

# Persistencia: la aplicacion se conecta al PostgreSQL publicado por Docker Compose.
USE_INMEMORY=false
DATABASE_URL=postgres://devuser:devpassword@localhost:5432/clean_architecture

# Outbox
USE_OUTBOX=true
OUTBOX_WORKER_MODE=once
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_MS=5000

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true

# Servidor HTTP
PORT=3000
